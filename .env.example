# Sites without a config file: INDEXNOW_SITES (JSON, same shape as the
# `sites` map in relay.config.ts). This is the compose/Coolify-friendly path;
# alternatively mount a relay.config.ts (then REMOVE INDEXNOW_SITES -
# providing both is a startup error).
INDEXNOW_SITES='{"www.example.com":"00000000000000000000000000000000"}'
# Note: wrap the JSON in single quotes - docker compose strips inner double quotes otherwise.

# Bearer token clients use for POST /v1/urls (and admin endpoints).
# In Coolify this comes from SERVICE_PASSWORD_64_RELAY automatically.
INDEXNOW_RELAY_TOKEN=change-me-at-least-16-chars

# Only needed with a relay.config.ts that uses env() references:
# INDEXNOW_KEY_WWW_EXAMPLE_COM=00000000000000000000000000000000
# INDEXNOW_KEY_DOCS_EXAMPLE_COM=11111111111111111111111111111111

# Optional overrides:
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
# INDEXNOW_RELAY_DB=/data/relay.db
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

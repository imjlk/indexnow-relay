# Bearer token clients use for POST /v1/urls (and admin endpoints).
INDEXNOW_RELAY_TOKEN=change-me-at-least-16-chars

# One IndexNow key per site (openssl rand -hex 16).
INDEXNOW_KEY_WWW_EXAMPLE_COM=00000000000000000000000000000000
INDEXNOW_KEY_DOCS_EXAMPLE_COM=11111111111111111111111111111111

# Optional overrides:
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
# INDEXNOW_RELAY_DB=/app/data/relay.db
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
